{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page_id" }],
      "destination": "/?",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "p" }],
      "destination": "/?",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/en", "destination": "/index.html" },
    { "source": "/en/", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/privacy/", "destination": "/index.html" },
    { "source": "/en/privacy", "destination": "/index.html" },
    { "source": "/en/privacy/", "destination": "/index.html" }
  ]
}
